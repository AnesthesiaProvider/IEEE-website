# ==============================================================================
# IEEE WIE Bennett University - Environment Configuration
# ==============================================================================

# Admin Dashboard Password (set a strong password in your local .env.local)
ADMIN_PASSWORD=your_secure_admin_password_here

# Admin Session Secret (Random string used to sign admin session tokens)
ADMIN_SESSION_SECRET=your_random_session_secret_here

# Optional: Supabase credentials (If provided, applications sync to Supabase)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Email Service Provider for confirmation emails (Resend / SendGrid)
# RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM=IEEE WIE Bennett University <wie@bennett.edu.in>
